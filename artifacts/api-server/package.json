    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.20.5"
