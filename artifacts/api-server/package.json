    "memorystore": "^1.6.7",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "resend": "^6.12.2",
    "socket.io": "^4.8.3",
    "stripe": "^20.0.0",
    "stripe-replit-sync": "^1.0.0",
    "twilio": "^5.11.2",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "yaml": "^2.8.4",
    "zod": "catalog:"
