  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "vite": "catalog:",
    "@types/pg": "^8.20.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.0",
    "@types/lodash": "^4.17.20",
