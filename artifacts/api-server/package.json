    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@xmldom/xmldom": "^0.8.13",
    "axios": "^1.16.0",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.7.0",
    "express": "^5.0.1",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
