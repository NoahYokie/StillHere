modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
APP_ENV = "staging"
DISABLE_FRONTEND = "1"
INTERNAL_CRON_ENABLED = "true"
APNS_KEY_ID = "RS4C8QJ3GZ"
ENABLE_APPLE_REVIEW_LOGIN = "true"
TWILIO_ALPHA_SENDER = "StillHere"
VAPID_SUBJECT = "mailto:admin@stillhere.health"
REVENUECAT_PROJECT_ID = "proj1619d6f2"
